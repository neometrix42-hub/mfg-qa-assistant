# Copy to .env and fill in. .env is gitignored - never commit it.

# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Full-access connection (ingest, doc_chunks, request_log)
DATABASE_URL=postgresql://mfgqa:mfgqa_dev_password@localhost:5433/mfgqa

# Read-only connection used ONLY by the query_measurements tool.
# This is the connection the LLM's SQL runs on.
READONLY_DATABASE_URL=postgresql://qa_reader:qa_reader_dev_password@localhost:5433/mfgqa

# Model + retrieval config. The config sweep in evals/run.py varies these.
CLAUDE_MODEL=claude-opus-5
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
